rules_version = '2';

// Browsers never read or write the bucket directly: only the API does, with
// its own service account (which these rules don't apply to). People get
// media through short-lived signed links the API hands out.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
