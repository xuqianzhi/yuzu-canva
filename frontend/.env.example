# Copy to .env.local and fill in. .env.local is gitignored; Vite loads it
# for `npm run dev` and `npm run build`.
#
# Vite puts every VITE_* value into the built JavaScript, so only public
# values belong here. Never put API keys for OpenAI, Ark or the database here.

# Firebase web app config (public by design: it names the project).
# Firebase console -> Project settings -> General -> Your apps -> the web app
# -> SDK setup and configuration -> Config.
# Production builds sign in with Google (Firebase Auth). The dev server
# (`npm run dev`) uses a dev sign-in instead (type any email; the local API
# accepts it), unless VITE_FIREBASE_IN_DEV=1 (then also set
# FIREBASE_PROJECT_ID and CANVAS_ALLOWED_EMAILS in backend/.env).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=yuzu-canva.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=yuzu-canva
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VITE_FIREBASE_IN_DEV=1

# --- Optional -----------------------------------------------------------------
# Where the dev server forwards /api (default: http://127.0.0.1:8788).
# Read by vite.config.ts from your shell, not from this file.
# CANVAS_API_URL=http://127.0.0.1:8788
