# Copy to .env and fill in. .env is gitignored, dockerignored and
# gcloudignored: it never leaves your machine. deploy/push-secrets.sh copies
# the three secrets below into Google Secret Manager for the deployed API.

# OpenAI: text, text-to-image, image-to-image
OPENAI_API_KEY=

# Volcengine Ark: Seedance video generation
ARK_API_KEY=

# The production database (Supabase): Connect -> Direct -> Connection string,
# method "Session pooler", type URI, with your database password in it.
# Only deploy/push-secrets.sh reads it: local work (docker compose) always
# uses the local Postgres in compose.yaml, never this one.
DATABASE_URL=

# If Docker Hub is unreachable, point at another Python 3.12 image.
# BASE_IMAGE=<registry>/<python-3.12-image>


# --- Local sign-in (defaults shown) ------------------------------------------
# Locally the API accepts "dev:<email>" sign-ins (the frontend's dev sign-in,
# used when frontend/.env.local has no Firebase config).
# CANVAS_DEV_AUTH=1
# To try real Google sign-in locally, also set these (and keep the Firebase
# config in frontend/.env.local):
# FIREBASE_PROJECT_ID=yuzu-canva
# CANVAS_ALLOWED_EMAILS=you@example.com

# --- Optional overrides (defaults shown) -----------------------------------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-2
# Text nodes, workflow text steps and node chat.
# OPENAI_TEXT_MODEL=gpt-5-mini
# Max wait for one OpenAI response, in seconds.
# OPENAI_TIMEOUT_S=300
# Jobs that may run at once.
# CANVAS_WORKER_CONCURRENCY=4
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
# Seconds between status checks, and the most to wait for one video.
# SEEDANCE_POLL_INTERVAL=10
# SEEDANCE_POLL_TIMEOUT=1800
# Max time for one Ark API call, e.g. creating a task with references, which
# can take minutes to upload from outside China.
# SEEDANCE_HTTP_TIMEOUT=900
# Generate placeholder images and videos offline instead of calling the
# real APIs (UI work).
# CANVAS_FAKE_GENERATORS=1
# Per-user daily limits (0 = none), waiting jobs, text calls per minute, and
# a switch that turns generation off.
# CANVAS_LIMIT_TEXT_PER_DAY=200
# CANVAS_LIMIT_IMAGES_PER_DAY=50
# CANVAS_LIMIT_VIDEOS_PER_DAY=10
# CANVAS_LIMIT_ACTIVE_JOBS=30
# CANVAS_LIMIT_TEXT_PER_MINUTE=10
# CANVAS_GENERATION_OFF=1
