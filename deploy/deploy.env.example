# Copy to deploy/deploy.env (gitignored) and fill in. Read by the deploy
# scripts; nothing here is a secret, but the emails are personal.

PROJECT=yuzu-canva
REGION=us-west1
SERVICE=yuzu-canva-api
# Cloud Storage for Firebase's default bucket (Firebase console -> Storage).
BUCKET=yuzu-canva.firebasestorage.app

# Who may sign in (comma-separated Google account emails).
ALLOWED_EMAILS=you@example.com

# Daily limits per user (0 = no limit), and generation on/off.
LIMIT_TEXT_PER_DAY=200
LIMIT_IMAGES_PER_DAY=50
LIMIT_VIDEOS_PER_DAY=10
GENERATION_OFF=0
